{
    "settings_popup": {
        "type": "array",
        "orientation": "vertical",
        "content": [
            {
                "type": "item",
                "item": "settings_header",
                "item_h_alignment": "center",
                "max_width": 300
            },
            {
                "type": "tabbed",
                "tabs": [
                    {
                        "title": "GOAL",
                        "icon": "images/settings/tabicons/tabicon_goals.png",
                        "content": [
                            {
                                "type": "itemgrid",
                                "item_margin": "4,4",
                                "h_alignment": "left",
                                "item_size": "192,192",
                                "rows": [
                                    [
                                        "golden_temple_setting",
                                        "orbs_setting"
                                    ]
                                ]
                            }
                        ]
                    },
                    {
                        "title": "PUZZLE PIECES",
                        "icon": "images/settings/tabicons/tabicon_pps.png",
                        "content": [
                            {
                                "type": "itemgrid",
                                "item_margin": "4,4",
                                "h_alignment": "center",
                                "item_size": "96,96",
                                "rows": [
                                    [
                                        "pp_setting"
                                    ],
                                    [
                                        "bossReq1",
                                        "bossReq2",
                                        "bossReq3",
                                        "bossReq4"
                                    ],
                                    [
                                        "bossReq5",
                                        "bossReq6",
                                        "bossReq7",
                                        "bossReq8"
                                    ]
                                ]
                            }
                        ]
                    },
                    {
                        "title": "KONG LETTERS",
                        "icon": "images/settings/tabicons/tabicon_kongs.png",
                        "content": [
                            {
                                "type": "itemgrid",
                                "item_margin": "4,4",
                                "h_alignment": "center",
                                "item_size": "96,96",
                                "rows": [
                                    [
                                        "kong_setting"
                                    ],
                                    [
                                        "kReq1",
                                        "kReq2",
                                        "kReq3",
                                        "kReq4"
                                    ],
                                    [
                                        "kReq5",
                                        "kReq6",
                                        "kReq7",
                                        "kReq8"
                                    ]
                                ]
                            }
                        ]
                    },
                    {
                        "title": "CLEAR TYPES",
                        "icon": "images/settings/tabicons/tabicon_clears.png",
                        "content": [
                            {
                                "type": "itemgrid",
                                "item_margin": "4,4",
                                "h_alignment": "left",
                                "item_size": "96,96",
                                "rows": [
                                    [
                                        "normal_clears_setting"
                                    ],
                                    [
                                        "mirror_mode_setting",
                                        "mirror_shards_setting"
                                    ],
                                    [
                                        "ta_bronze_setting",
                                        "ta_silver_setting",
                                        "ta_gold_setting",
                                        "ta_shiny_gold_setting"
                                    ]
                                ]
                            }
                        ]
                    },
                    {
                        "title": "MISC.",
                        "icon": "images/settings/tabicons/tabicon_misc.png",
                        "content": [
                            {
                                "type": "itemgrid",
                                "item_margin": "4,4",
                                "h_alignment": "center",
                                "item_size": "96,96",
                                "rows": [
                                    [
                                        "key1_setting",
                                        "key2_setting",
                                        "key3_setting",
                                        "key4_setting"
                                    ],
                                    [
                                        "key5_setting",
                                        "key6_setting",
                                        "key7_setting",
                                        "key8_setting"
                                    ],
                                    [
                                        "smog_clear_setting",
                                        "lolReq_setting",
                                        "factory_button_setting",
                                        "fc_setting"
                                    ]
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}